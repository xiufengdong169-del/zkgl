{
  "name": "zkgl",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@cloudbase/node-sdk": "^4.0.3"
  },
  "description": "众肯科技项目全过程管理系统",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@cloudbase/node-sdk@^4.0.3": {
      "axios": "^1.12.2"
    }
  },
  "scripts": {
    "dev": "npm run dev -w @zkgl/web",
    "build": "npm run build -ws --if-present",
    "build:function": "npm run build -w @zkgl/api && node scripts/prepare-cloudbase-function.mjs",
    "test": "npm run test -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "verify": "npm run typecheck && npm run test && npm run build && node scripts/verify-source-secret-hygiene.mjs && npm run verify:requirements && node scripts/verify-web-dist-security.mjs && npm run verify:deployment-config && npm run verify:performance-acceptance && node scripts/verify-server-deployment-assets.mjs && node scripts/verify-backup-assets.mjs && npm run verify:object-restore && npm run verify:initialization-data && node scripts/verify-server-preflight.mjs && npm run verify:local-demo && npm run verify:local-user-testing",
    "verify:acceptance": "npm run verify && npm audit --omit=dev",
    "verify:deployment-config": "node scripts/verify-deployment-config.mjs",
    "verify:github-actions": "node scripts/verify-github-actions.mjs",
    "verify:github-sync": "node scripts/verify-github-sync.mjs",
    "verify:local-demo": "node scripts/verify-local-demo.mjs",
    "verify:local-user-testing": "node scripts/verify-local-user-testing-doc.mjs",
    "verify:performance-acceptance": "node scripts/verify-performance-acceptance-assets.mjs",
    "verify:requirements": "node scripts/verify-requirement-baseline.mjs",
    "demo:local": "node scripts/serve-local-demo.mjs",
    "verify:legacy-cloudbase": "npm run build:function && node scripts/verify-cloudbase-function-packages.mjs",
    "verify:public-demo": "node scripts/verify-public-demo.mjs",
    "verify:server-env": "node scripts/verify-server-env.mjs",
    "verify:object-restore": "node scripts/verify-object-restore-manifest.mjs",
    "verify:initialization-data": "node scripts/verify-initialization-data.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
